# ==============================================================================
# .env.example – file mẫu, sao chép thành `.env` (đã .gitignore) nếu muốn dùng biến môi trường.
# Dùng thay cho application-local.yml: `application.yml` đọc hết các biến dưới đây.
# KHÔNG commit file `.env` thật (chứa mật khẩu/token).
# ==============================================================================

# ------------------------------- CSDL SQL Server -------------------------------
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=BadminStore;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=

# ------------------------------- Tài khoản ADMIN -------------------------------
ADMIN_EMAIL=admin@badstore.local
ADMIN_PASSWORD=
# UPLOAD_DIR=uploads

# ------------------------------- Thông tin cửa hàng ---------------------------
# SHOP_NAME=BadStore
# SHOP_ADDRESS=Số 1 Đại Cồ Việt, Bách Khoa, Hà Nội
# SHOP_HOTLINE=1900 0000
# SHOP_EMAIL=cskh@badstore.local

# ------------------------------- GHN (tuỳ chọn) --------------------------------
# Demo offline: GHN_ENABLED=true + GHN_MOCK=true (không cần mạng/token)
# Lấy địa chỉ thật: GHN_ENABLED=true + GHN_MOCK=false + GHN_TOKEN
#   → sổ địa chỉ/thanh toán có dropdown Tỉnh → Huyện → Xã lấy từ GHN.
# Tính phí + tạo vận đơn thật: cần thêm GHN_SHOP_ID + GHN_FROM_DISTRICT_ID.
GHN_ENABLED=false
GHN_MOCK=false
# GHN_MOCK_STATUS=delivering
# GHN_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api
# GHN_TOKEN=
# GHN_SHOP_ID=
# GHN_FROM_DISTRICT_ID=
# GHN_FROM_WARD_CODE=
# GHN_FROM_PHONE=0900000000
# GHN_SYNC_ENABLED=false
