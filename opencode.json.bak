{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["docs/TIEU_CHI_KHA.md"
],
  "permission": {
    "edit": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*application-local.yml": "deny"
    },
    "bash": {
      "*": "allow",
      "./mvnw *": "allow",
      "mvnw.cmd *": "allow",
      "mvn *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "ask",
      "git push*": "deny",
      "rm -rf*": "deny"
    }
  }
}
